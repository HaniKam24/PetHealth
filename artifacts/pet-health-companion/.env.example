# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Vite only exposes env vars prefixed VITE_ to browser code, and only reads
# this directory's own .env files (not the monorepo root's).

# Clerk publishable key (Clerk Dashboard -> API Keys -> Publishable key).
# Safe to expose to the browser — it's not a secret.
VITE_CLERK_PUBLISHABLE_KEY=
